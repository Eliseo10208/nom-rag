# Copy this file to .env on the VPS and keep it chmod 600.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# Public DNS name whose A record points at the VPS IPv4 address.
NOMRAG_DOMAIN=nom-rag.example.com

NOMRAG_PROVIDER=gemini
NOMRAG_GENERATION_MODEL=gemini-3.1-flash-lite
NOMRAG_MAX_CONCURRENT_QUERIES=2
NOMRAG_QUERY_WAIT_TIMEOUT_SECONDS=60
